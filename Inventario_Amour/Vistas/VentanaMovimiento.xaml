<Window x:Class="Inventario_Amour.Vistas.VentanaMovimiento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:packIcon="http://materialdesigninxaml.net/winfx/xaml/shared"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="280" Width="400"
        
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml"/>
                
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#FFFDFEFF" CornerRadius="20" Padding="20" BorderBrush="#43CCC3" BorderThickness="2" SnapsToDevicePixels="True">
        <Grid>
            <!-- Botón de cerrar flotante -->
            <Button 
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="30"
                Height="30"
                Margin="0 0 0 0"
                Background="#E47EAC" Foreground="White"
                ToolTip="Cerrar"
                
                Command="{x:Static ApplicationCommands.Close}">
                <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#E47EAC"/>
            </Button>

            <!-- Contenido principal -->
            <Grid Margin="10" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Producto:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0 5" Foreground="#362C4F"/>
                <ComboBox  Grid.Row="0" Grid.Column="1"
                    ItemsSource="{Binding ProductosFiltrados}" 
                    SelectedItem="{Binding ProductoSeleccionado}" 
                    IsEditable="True" 
                    Margin="5"
                    DisplayMemberPath="Nombre"
                    Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                    StaysOpenOnEdit="True"
                    IsTextSearchEnabled="False" />

                <TextBlock Text="Cantidad:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0 5" Foreground="#362C4F"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5" />

                <TextBlock Text="Tipo de Movimiento:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0 5" Foreground="#362C4F"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding TiposMovimiento}"
                          SelectedItem="{Binding TipoSeleccionado}"
                          Margin="5" />

                <Button Grid.Row="3" Grid.ColumnSpan="2"
                        Content="Registrar"
                        Command="{Binding RegistrarMovimientoCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        HorizontalAlignment="Center"
                        Margin="10"
                        Background="#E47EAC"
                        FontWeight="Bold"
                        Padding="10 5"
                        Style="{StaticResource MaterialDesignFlatButton}" />
            </Grid>
        </Grid>
    </Border>
</Window>
